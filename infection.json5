{
    "$schema": "../../../vendor/infection/infection/resources/schema.json",
    // The reset and the plugin's registration: the code whose every line must be needed by a test.
    "source": {
        "directories": ["."],
        "excludes": [".github", "caddy", "console", "contracts", "tests", "updates", "vendor", "routes.php"]
    },
    // Winter's class loader, not Composer's, loads the modules' classes, which Infection reads while
    // it builds the mutants.
    "bootstrap": "tests/bootstrap.php",
    "phpUnit": {
        "configDir": ".",
        "customPath": "../../../vendor/bin/phpunit"
    },
    // The soak test covers nearly every line of the reset, so it would run for every mutant and
    // take most of the time, while the two-request tests it repeats already kill the same mutants.
    "testFrameworkOptions": "--testsuite=Octane --exclude-group=soak",
    "timeout": 60,
    "logs": {
        "text": "infection.log",
        "summary": "infection-summary.log"
    },
    // Measured at 74% with 4 threads and 75% with 11 (335 mutants: 246 to 249 killed, 5 timed out,
    // 81 to 84 escaped). The floor sits a few points below that, so new code without tests fails
    // the run but a small change in the number of mutants does not.
    "minMsi": 70,
    "minCoveredMsi": 70
}
