<?xml version="1.0"?>
<ruleset name="Winter CMS">
    <description>The coding standard for Winter CMS.</description>
    <rule ref="PSR2">
        <!--
        Exceptions to the PSR-2 guidelines as per our Developer Guide:
        https://wintercms.com/help/guidelines/developer#psr-exceptions
        -->
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps" />
        <exclude name="Squiz.ControlStructures.ControlSignature.SpaceAfterCloseBrace" />
        <exclude name="PSR2.ControlStructures.ControlStructureSpacing.SpacingAfterOpenBrace" />

        <!-- We're not enforcing a line length limit -->
        <exclude name="Generic.Files.LineLength" />
    </rule>

    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <!-- Test cases can declare their fixture classes alongside the test -->
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <!-- routes.php mixes an environment guard with route declarations by design -->
        <exclude-pattern>routes.php</exclude-pattern>
    </rule>

    <arg name="extensions" value="php" />
    <arg name="colors" />

    <file>Plugin.php</file>
    <file>routes.php</file>
    <file>classes/</file>
    <file>contracts/</file>
    <file>tests/</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
